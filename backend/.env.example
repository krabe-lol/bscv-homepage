# Nur auf dem Server, scripts/output.mjs schreibt sie in die dortige .env
# PUBLIC_URL=https://cms.bscv.de
# IS_PROXIED=true
# CORS_ORIGIN=https://bscv.de,https://www.bscv.de
# SMTP_HOST= SMTP_PORT= SMTP_USERNAME= SMTP_PASSWORD= SMTP_FROM= (optional, für Mails aus Strapi)

# Abgleich mit Papierstau (Vereine, Renntermine, Punktewertung). Ohne URL und Schlüssel ist er aus.
# Auf dem Server in backend/.env.server eintragen, scripts/output.mjs übernimmt sie in die .env.
# PAPIERSTAU_URL=https://papierstau.example.org/api/external/v1
# PAPIERSTAU_API_KEY=pak_…               (in Papierstau: Admin → API-Schlüssel, Rechte clubs, events, standings)
# PAPIERSTAU_SYNC_TOKEN=                 (mind. 32 Zeichen, z. B. openssl rand -hex 32; in Papierstau als BSCV_SYNC_TOKEN)
