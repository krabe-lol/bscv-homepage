{
  "kind": "collectionType",
  "collectionName": "events",
  "info": { "singularName": "event", "pluralName": "events", "displayName": "Veranstaltung" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string" },
    "date": { "type": "date" },
    "track": { "type": "relation", "relation": "manyToOne", "target": "api::track.track" },
    "organizer": { "type": "relation", "relation": "manyToOne", "target": "api::club.club" },
    "albums": { "type": "relation", "relation": "oneToMany", "target": "api::album.album", "mappedBy": "event" }
  }
}
