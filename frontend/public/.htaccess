# Apache (Hetzner Webhosting): Unterseiten wie /renntermine gibt es nur im React-Router,
# also alles, was keine echte Datei oder kein Ordner ist, an index.html geben.
RewriteEngine On

# Alte WordPress-Adressen, die von außen noch verlinkt sind, auf den Dokumente-Bereich der Startseite
RewriteRule ^ausschreibung/?$ /#dokumente [R=301,NE,L]
RewriteRule ^wp-content/uploads/.*ausschreibung.*\.pdf$ /#dokumente [R=301,NE,NC,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  # Browser merken sich, die Seite nur noch per HTTPS aufzurufen (ohne includeSubDomains, falls es
  # Subdomains ohne Zertifikat gibt)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Dateinamen unter /assets enthalten einen Hash und ändern sich bei jedem Build
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # index.html immer neu prüfen, damit nach einem Deploy sofort die neuen Assets geladen werden
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
